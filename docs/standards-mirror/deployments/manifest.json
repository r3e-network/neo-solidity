{
  "pairs": [
    {
      "id": "erc-20",
      "title": "ERC-20 ↔ NEP-17 — Fungible Token",
      "docEntry": "/standards-mirror/tokens#erc-20",
      "solidity": {
        "source": "erc-20/solidity/DemoToken.sol",
        "contract": "DemoToken",
        "outName": "DemoTokenSol",
        "deployData": [],
        "clearSupportedStandards": true,
        "tests": [
          { "name": "symbol == DEMOSOL", "kind": "read", "operation": "symbol", "args": [], "expect": { "type": "ByteString", "value": "44454d4f534f4c" } },
          { "name": "decimals == 8", "kind": "read", "operation": "decimals", "args": [], "expect": { "type": "Integer", "value": "8" } },
          { "name": "faucet(deployer, 100T)", "kind": "write", "operation": "faucet", "args": [{ "type": "Hash160", "value": "$DEPLOYER_ADDRESS" }, { "type": "Integer", "value": "100000000000000" }] },
          { "name": "balanceOf(deployer) == 100T", "kind": "read", "operation": "balanceOf", "args": [{ "type": "Hash160", "value": "$DEPLOYER_ADDRESS" }], "expect": { "type": "Integer", "value": "100000000000000" } },
          { "name": "totalSupply == 100T", "kind": "read", "operation": "totalSupply", "args": [], "expect": { "type": "Integer", "value": "100000000000000" } }
        ]
      },
      "csharp": {
        "csproj": "erc-20/csharp/DemoToken.csproj",
        "deployData": null,
        "tests": [
          { "name": "symbol == DEMOCSH", "kind": "read", "operation": "symbol", "args": [], "expect": { "type": "ByteString", "value": "44454d4f435348" } },
          { "name": "decimals == 8", "kind": "read", "operation": "decimals", "args": [], "expect": { "type": "Integer", "value": "8" } },
          { "name": "totalSupply == 100T", "kind": "read", "operation": "totalSupply", "args": [], "expect": { "type": "Integer", "value": "100000000000000" } },
          { "name": "balanceOf(deployer) == 100T", "kind": "read", "operation": "balanceOf", "args": [{ "type": "Hash160", "value": "$DEPLOYER_ADDRESS" }], "expect": { "type": "Integer", "value": "100000000000000" } }
        ]
      }
    },

