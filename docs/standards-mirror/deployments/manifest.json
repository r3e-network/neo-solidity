      "solidity": {
        "source": "erc-2981/solidity/RoyaltyNFT.sol",
        "contract": "RoyaltyNFT",
        "outName": "RoyaltyNFTSol",
        "deployData": [],
        "clearSupportedStandards": true,
        "tests": [
          { "name": "symbol == DSOLROY", "kind": "read", "operation": "symbol", "args": [], "expect": { "type": "ByteString", "value": "44534f4c524f59" } },
          { "name": "mint(deployer)", "kind": "write", "operation": "mint", "args": [{ "type": "Hash160", "value": "$DEPLOYER_ADDRESS" }] },
          { "name": "setDefaultRoyalty(deployer, 500)", "kind": "write", "operation": "setDefaultRoyalty", "args": [{ "type": "Hash160", "value": "$DEPLOYER_ADDRESS" }, 500] }
        ]
      },
      "csharp": {
        "csproj": "erc-2981/csharp/RoyaltyNFT.csproj",
        "deployData": null,
        "tests": [
          { "name": "symbol == DCSHROY", "kind": "read", "operation": "symbol", "args": [], "expect": { "type": "ByteString", "value": "44435348524f59" } },
          { "name": "mint(deployer, ...)", "kind": "write", "operation": "mint", "args": [{ "type": "Hash160", "value": "$DEPLOYER_ADDRESS" }, "T1", "Royalty mirror"] },
          { "name": "totalSupply >= 1", "kind": "read", "operation": "totalSupply", "args": [], "expect": { "type": "Integer", "value": "1" } }
        ]
      }
    },

    {
      "id": "erc-3525",
      "title": "ERC-3525 — Semi-Fungible Bond",
      "docEntry": "/standards-mirror/tokens#erc-3525",
      "solidity": {
        "source": "erc-3525/solidity/Bond.sol",
        "contract": "Bond",
        "outName": "BondSol",
        "deployData": [],
        "clearSupportedStandards": true,
        "tests": [
          { "name": "symbol == DSOLBND", "kind": "read", "operation": "symbol", "args": [], "expect": { "type": "ByteString", "value": "44534f4c424e44" } },
          { "name": "mint(deployer, slot=1, value=1000)", "kind": "write", "operation": "mint", "args": [{ "type": "Hash160", "value": "$DEPLOYER_ADDRESS" }, 1, 1000] },
          { "name": "balanceOfToken(1) == 1000", "kind": "read", "operation": "balanceOfToken", "args": [1], "expect": { "type": "Integer", "value": "1000" } },
          { "name": "slotOf(1) == 1", "kind": "read", "operation": "slotOf", "args": [1], "expect": { "type": "Integer", "value": "1" } }
        ]
      },
      "csharp": {
        "csproj": "erc-3525/csharp/Bond.csproj",
        "deployData": null,
        "tests": [
          { "name": "symbol == DCSHBND", "kind": "read", "operation": "symbol", "args": [], "expect": { "type": "ByteString", "value": "44435348424e44" } },
          { "name": "valueDecimals == 8", "kind": "read", "operation": "valueDecimals", "args": [], "expect": { "type": "Integer", "value": "8" } },
          { "name": "mint(deployer, slot=1, value=1000)", "kind": "write", "operation": "mint", "args": [{ "type": "Hash160", "value": "$DEPLOYER_ADDRESS" }, 1, 1000] }
        ]
      }
    }
  ]
}
